# NEPSE Bot environment variables
# Copy this file to .env and fill in values. Never commit .env.

# Runtime mode: research | backtest | paper | live
# Default is paper. live remains blocked until an official broker API exists.
BOT_MODE=paper

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Data
DATA_DIR=data/storage
TIMEZONE=Asia/Kathmandu

# Risk defaults (can also be set in config/default.yaml)
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_OPEN_POSITIONS=3
MAX_POSITION_SIZE_PCT=20.0

# Broker credentials — leave empty until official API exists
# BROKER_API_KEY=
# BROKER_API_SECRET=
# BROKER_USERNAME=
# BROKER_PASSWORD=
